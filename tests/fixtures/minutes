#!/usr/bin/env node
// A fixture Minutes command: it reads the prompt on stdin the way a model
// would, keeps a copy where SCRIBE_TEST_PROMPT_LOG says, and prints a title
// and fixed Minutes, then fixed Topics. With SCRIBE_TEST_MINUTES_FAIL set, it
// fails the way a command with no model does: a sentence on stderr and a
// non-zero exit. With SCRIBE_TEST_ARGS_LOG set, it writes the arguments it was
// given there, as JSON, so a test can see that none was changed on the way.
// With SCRIBE_TEST_MINUTES_HANG set to a file, it starts a process of its own
// that holds its pipes, writes that process's id to the file, and never
// answers, the way a model that hangs does.
// SCRIBE_TEST_TOPICS=none leaves the Topics out, the way a
// model that forgets a rule does; SCRIBE_TEST_TOPICS=long writes 25 lines.
// With SCRIBE_TEST_TOPICS_FILE set, the Topics are what that file holds at
// the time of the run, so a test can make the Topics change between runs.
import { spawn } from 'node:child_process';
import { readFileSync, writeFileSync } from 'node:fs';

if (process.env.SCRIBE_TEST_ARGS_LOG) {
  writeFileSync(process.env.SCRIBE_TEST_ARGS_LOG, JSON.stringify(process.argv.slice(2)));
}

if (process.env.SCRIBE_TEST_MINUTES_HANG) {
  const started = spawn(process.execPath, ['-e', 'setInterval(() => {}, 1000)'], {
    stdio: 'inherit',
  });
  writeFileSync(process.env.SCRIBE_TEST_MINUTES_HANG, String(started.pid));
  setInterval(() => {}, 1000);
}

let prompt = '';
process.stdin.setEncoding('utf8');
process.stdin.on('data', (chunk) => (prompt += chunk));
process.stdin.on('end', () => {
  if (process.env.SCRIBE_TEST_MINUTES_HANG) return;
  if (process.env.SCRIBE_TEST_PROMPT_LOG) writeFileSync(process.env.SCRIBE_TEST_PROMPT_LOG, prompt);
  if (process.env.SCRIBE_TEST_MINUTES_FAIL) {
    process.stderr.write('pulling manifest\nError: model "nada" not found\n');
    process.exit(3);
  }
  const lines = (prompt.match(/\] (Você|Outros): /g) || []).length;
  const topics = process.env.SCRIBE_TEST_TOPICS_FILE
    ? `\n<topics>\n${readFileSync(process.env.SCRIBE_TEST_TOPICS_FILE, 'utf8')}\n</topics>\n`
    : process.env.SCRIBE_TEST_TOPICS === 'none'
      ? ''
      : process.env.SCRIBE_TEST_TOPICS === 'long'
        ? `\n<topics>\n${Array.from({ length: 25 }, (_, i) => `- Tópico ${i + 1}`).join('\n')}\n</topics>\n`
        : '\n<topics>\n- Prazo da entrega\n\nCombinamos a entrega para sexta.\n</topics>\n';
  process.stdout.write(
    'TITLE: Prazo da entrega\n\n## Prazo\n- Entrega na **sexta**.\n\n' +
      `## Decisões\n- ${lines} linhas lidas.\n\n## Próximos passos\n- Nenhuma.\n` +
      topics,
  );
});
